{
  "name": "agentic-dev-sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // OWASP Docker Security Cheat Sheet: drop every Linux capability Docker
  // grants by default (CHOWN, SETUID, MKNOD, and others this container
  // never needs). The agentic-sandbox-firewall Feature below adds back
  // only NET_ADMIN/NET_RAW via its own "capAdd" — we don't need to name
  // them here too.
  "runArgs": ["--cap-drop=ALL"],
  "remoteUser": "agent",
  "containerUser": "agent",
  // Local reference to this repo's own published Feature (dogfooding —
  // one copy of the firewall logic, not a second one maintained here).
  // Relative paths in "features" resolve to the folder containing THIS
  // file, i.e. .devcontainer/, hence "../src/...". The Feature's
  // entrypoint re-applies the firewall on every container start, not
  // just first creation, so there's no postCreateCommand/postStartCommand
  // needed here for it.
  "features": {
    "../src/agentic-sandbox-firewall": {
      "remoteUser": "agent"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  // Deliberately no mounts of $HOME, ~/.ssh, ~/.aws, or any other
  // credential directory on the host. Real auth is provided at runtime
  // via workload-identity-federation (see agents/example-agent.yaml and
  // README.md), never via a static key bind-mounted into the container.
  "mounts": [],
  "shutdownAction": "stopContainer"
}
